---
// Authenticated-app shell for every /app/* route. Everything on screen comes from the AX_Chat_Be API:
// the workspace switcher (GET /workspaces), the credits meter (workspace usage) and the signed-in user.
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import '../styles/app.css';

interface Props { title: string; description?: string }
const { title, description = 'Thosjod app' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');

// Per-assistant pages: all keyed by ?id=<assistant uuid>
const assistantNav = [
  { label: 'Settings', href: '/app/assistants/settings' },
  { label: 'Knowledge', href: '/app/assistants/knowledge' },
  { label: 'Playground', href: '/app/assistants/playground' },
  { label: 'Leads', href: '/app/assistants/leads' },
  { label: 'Deploy', href: '/app/assistants/deploy' },
];
const inAssistant = assistantNav.some((i) => i.href === path);
---

<Base title={`${title} - Thosjod`} description={description} noindex nofollow>
  <script is:inline>
    // Auth guard - runs before paint so signed-out visitors never see the shell
    try { if (!localStorage.getItem('tj-access')) location.replace('/login?next=' + encodeURIComponent(location.pathname + location.search)); } catch (e) {}
  </script>
  <div class="app" data-app>
    <aside class="side" data-side>
      <div class="side-top">
        <a href="/app/assistants" class="side-logo" aria-label="Thosjod app home"><Logo variant="dark" height={24} /></a>
        <button class="side-close" data-side-close aria-label="Close menu"><Icon name="x" size={18} /></button>
      </div>

      <label class="ws">
        <span class="ws-avatar" data-ws-avatar>·</span>
        <span class="ws-text">
          <select data-ws-select aria-label="Workspace"><option>Loading…</option></select>
          <span data-ws-plan></span>
        </span>
      </label>

      <nav class="side-nav" aria-label="App">
        <ul>
          <li>
            <a href="/app/assistants" class:list={['nav-link', { active: path.startsWith('/app/assistants') }]}><Icon name="agent" size={16} />Assistants</a>
            {inAssistant && (
              <ul class="nav-sub">
                <li class="nav-sub-name" data-assistant-name>Assistant</li>
                {assistantNav.map((i) => (
                  <li><a href={i.href} data-keep-id class:list={['nav-sublink', { active: path === i.href }]} aria-current={path === i.href ? 'page' : undefined}>{i.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li><a href="/app/workspace" class:list={['nav-link', { active: path === '/app/workspace' }]}><Icon name="gear" size={16} />Workspace</a></li>
        </ul>
      </nav>

      <div class="side-foot">
        <div class="credits" data-credits hidden>
          <span class="cr-top"><span>Credits used</span><span data-cr-pct></span></span>
          <span class="cr-bar"><span data-cr-bar></span></span>
          <span class="cr-sub" data-cr-sub></span>
        </div>
      </div>
    </aside>
    <div class="side-scrim" data-side-close></div>

    <div class="main">
      <header class="topbar">
        <button class="menu-btn" data-side-open aria-label="Open menu"><Icon name="menu" size={18} /></button>
        <div class="top-actions">
          <span class="me-name" data-me-name></span>
          <span class="me" aria-hidden="true"><span data-me-initials></span></span>
          <button class="icon-btn-app" data-logout aria-label="Log out" title="Log out"><Icon name="logout" size={16} /></button>
        </div>
      </header>

      <main class="content" id="main">
        <slot />
      </main>
    </div>

    <div class="toasts" aria-live="polite" data-toasts></div>

    <dialog class="confirm" data-confirm-dialog>
      <form method="dialog">
        <p class="confirm-title" data-confirm-title>Are you sure?</p>
        <p class="confirm-body" data-confirm-body></p>
        <div class="confirm-actions">
          <button value="cancel" class="abtn abtn-ghost">Cancel</button>
          <button value="ok" class="abtn abtn-danger" data-confirm-ok>Confirm</button>
        </div>
      </form>
    </dialog>
  </div>
</Base>

<script>
  import { api, session, logout, esc } from '../lib/api';

  // ---- toasts + confirm dialog, exposed for the page scripts (see lib/api.ts)
  const toastRoot = document.querySelector<HTMLElement>('[data-toasts]')!;
  (window as any).tjToast = (msg: string) => {
    const el = document.createElement('div');
    el.className = 'toast';
    el.textContent = msg;
    toastRoot.appendChild(el);
    setTimeout(() => el.classList.add('out'), 3200);
    setTimeout(() => el.remove(), 3700);
  };
  const dlg = document.querySelector<HTMLDialogElement>('[data-confirm-dialog]')!;
  (window as any).tjConfirm = (title: string, body: string, ok: string): Promise<boolean> =>
    new Promise((resolve) => {
      dlg.querySelector('[data-confirm-title]')!.textContent = title;
      dlg.querySelector('[data-confirm-body]')!.textContent = body;
      dlg.querySelector('[data-confirm-ok]')!.textContent = ok;
      dlg.returnValue = '';
      dlg.showModal();
      dlg.addEventListener('close', () => resolve(dlg.returnValue === 'ok'), { once: true });
    });

  // ---- generic UI: mobile sidebar, modals, logout
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-side-open],[data-side-close],[data-open-modal],[data-close-modal],[data-logout]');
    if (!t) return;
    if (t.dataset.sideOpen !== undefined) document.querySelector('[data-app]')!.classList.add('side-open');
    else if (t.dataset.sideClose !== undefined) document.querySelector('[data-app]')!.classList.remove('side-open');
    else if (t.dataset.openModal) document.querySelector<HTMLDialogElement>(`#${t.dataset.openModal}`)?.showModal();
    else if (t.dataset.closeModal !== undefined) t.closest('dialog')?.close();
    else if (t.dataset.logout !== undefined) logout();
  });

  // ---- keep ?id= on the per-assistant nav links
  const id = new URLSearchParams(location.search).get('id');
  if (id) document.querySelectorAll<HTMLAnchorElement>('[data-keep-id]').forEach((a) => (a.href = `${a.pathname}?id=${encodeURIComponent(id)}`));

  // ---- signed-in user; validated with GET /auth/me like AX_Chat_Fe's AuthProvider (a bad token logs out via api())
  const showUser = (user: { name: string } | null) => {
    if (!user) return;
    document.querySelector('[data-me-name]')!.textContent = user.name;
    document.querySelector('[data-me-initials]')!.textContent = user.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
  };
  showUser(session.user());
  api('/auth/me').then((user) => {
    try { localStorage.setItem('tj-user', JSON.stringify(user)); } catch {}
    showUser(user);
  }).catch(() => {});

  // ---- workspace switcher + credits meter
  const sel = document.querySelector<HTMLSelectElement>('[data-ws-select]')!;
  const paint = (ws: any) => {
    document.querySelector('[data-ws-avatar]')!.textContent = (ws.name || '?')[0].toUpperCase();
    document.querySelector('[data-ws-plan]')!.textContent = `${ws.tier} plan · ${ws.role}`;
    const pct = ws.credits_limit ? Math.min(100, Math.round((ws.credits_used / ws.credits_limit) * 100)) : 0;
    document.querySelector<HTMLElement>('[data-credits]')!.hidden = false;
    document.querySelector('[data-cr-pct]')!.textContent = `${pct}%`;
    document.querySelector<HTMLElement>('[data-cr-bar]')!.style.width = `${pct}%`;
    document.querySelector('[data-cr-sub]')!.textContent = `${ws.credits_used.toLocaleString()} of ${ws.credits_limit.toLocaleString()} · ${ws.billing_reset_date}`;
  };
  api<any[]>('/workspaces').then((list) => {
    if (!list.length) { sel.innerHTML = '<option>No workspace</option>'; return; }
    let current = session.workspace();
    // Default like AX_Chat_Fe DashboardLayout: the user's own tenant workspace, else the first one
    if (!list.some((w) => w.slug === current)) current = (list.find((w) => w.slug === session.user()?.tenant_slug) ?? list[0]).slug;
    session.setWorkspace(current!);
    sel.innerHTML = list.map((w) => `<option value="${esc(w.slug)}" ${w.slug === current ? 'selected' : ''}>${esc(w.name)}</option>`).join('');
    paint(list.find((w) => w.slug === current));
    (window as any).tjWorkspaces = list;
    document.dispatchEvent(new CustomEvent('tj:workspace', { detail: list.find((w) => w.slug === current) }));
    sel.addEventListener('change', () => {
      session.setWorkspace(sel.value);
      location.href = location.pathname.startsWith('/app/assistants/') ? '/app/assistants' : location.pathname;
    });
  }).catch(() => { sel.innerHTML = '<option>Unavailable</option>'; });
</script>
