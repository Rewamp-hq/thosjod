---
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import Panel from '../../../components/app/Panel.astro';
import Bits from '../../../components/app/Bits.astro';
import Action from '../../../components/app/Action.astro';
import FormDialog from '../../../components/app/FormDialog.astro';
import { agents } from '../../../data/app/sample';
---

<AppShell title="Agents" description="List and configure all active AI agents.">
  <AppHeader title="Agents" desc="List and configure all active AI agents." actions={[{ label: 'Create Agent', icon: 'plus', modal: 'dlg-agent' }]} />

  <Panel empty="No agents configured - create your first agent." emptyIcon="agent" emptyAction={{ label: 'Create Agent', modal: 'dlg-agent' }} flush>
    <div class="tbl-scroll">
      <table class="atbl" id="t-agents" data-filterable>
        <thead><tr><th>Agent Name</th><th>Type</th><th>Status</th><th>Conversations This Month</th><th></th></tr></thead>
        <tbody>
          {agents.map((a) => (
            <tr>
              <td><a class="row-link" href={a.href}>{a.name}</a></td>
              <td><Bits pill={a.type} /></td>
              <td><Bits pill={a.status} /></td>
              <td class="num">{a.conversations}</td>
              <td style="text-align:right">
                <Action
                  label="Delete" variant="ghost" size="sm" removeRow
                  confirm={`Delete “${a.name}”?`}
                  confirmBody={`This permanently removes the ${a.type} agent and its configuration. Its ${a.conversations} conversations this month stay in Conversations, but the agent will stop responding to visitors immediately.`}
                  confirmOk="Delete agent"
                  toast={`${a.name} deleted.`}
                />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>

  <FormDialog
    id="dlg-agent" title="Create agent" submit="Create agent" toast="{name} created."
    fields={[
      { name: 'name', label: 'Agent name', placeholder: 'e.g. Pricing page assistant' },
      { name: 'type', label: 'Type', type: 'select', options: ['Sales', 'Support', 'Voice'] },
    ]}
  />
</AppShell>
