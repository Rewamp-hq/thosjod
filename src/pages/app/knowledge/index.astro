---
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import Panel from '../../../components/app/Panel.astro';
import Bits from '../../../components/app/Bits.astro';
import Action from '../../../components/app/Action.astro';
import FormDialog from '../../../components/app/FormDialog.astro';
import { knowledge } from '../../../data/app/sample';
---

<AppShell title="Knowledge Base" description="Manage the content sources agents are grounded in.">
  <AppHeader title="Knowledge Base" desc="Manage the content sources agents are grounded in." actions={[{ label: 'Add Source', icon: 'plus', modal: 'dlg-source' }]} />

  <Panel empty="No knowledge sources yet - add your first page or document." emptyIcon="book" emptyAction={{ label: 'Add Source', modal: 'dlg-source' }} flush>
    <div class="tbl-scroll">
      <table class="atbl" id="t-knowledge" data-filterable>
        <thead><tr><th>Source</th><th>Type</th><th>Last Synced</th><th>Status</th><th></th></tr></thead>
        <tbody>
          {knowledge.map((k) => (
            <tr>
              <td class="strong">{k.source}</td><td>{k.type}</td><td class="num">{k.synced}</td><td><Bits pill={k.status} /></td>
              <td style="text-align:right"><Action label="Re-sync" variant="ghost" size="sm" toast={`Re-sync started for ${k.source}.`} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>

  <FormDialog
    id="dlg-source" title="Add source" submit="Add source" toast="Source added - syncing now."
    fields={[
      { name: 'type', label: 'Type', type: 'select', options: ['Page', 'PDF', 'Doc', 'Sitemap'] },
      { name: 'url', label: 'URL or file link', placeholder: 'https://yourcompany.com/pricing', type: 'url' },
    ]}
  />
</AppShell>
