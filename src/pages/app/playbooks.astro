---
import AppShell from '../../layouts/AppShell.astro';
import AppHeader from '../../components/app/AppHeader.astro';
import Panel from '../../components/app/Panel.astro';
import Bits from '../../components/app/Bits.astro';
import FormDialog from '../../components/app/FormDialog.astro';
import { playbooks } from '../../data/app/sample';
---

<AppShell title="Playbooks" description="Natural-language automation playbooks.">
  <AppHeader title="Playbooks" desc="Natural-language automation playbooks." crumbs={[{ label: 'Agents', href: '/app/agents' }]} actions={[{ label: 'New Playbook', icon: 'plus', modal: 'dlg-playbook' }]} />

  <Panel empty="No playbooks yet - describe your first outbound strategy in plain language." emptyIcon="spark" emptyAction={{ label: 'New Playbook', modal: 'dlg-playbook' }} flush>
    <div class="tbl-scroll">
      <table class="atbl" id="t-playbooks" data-filterable>
        <thead><tr><th>Playbook Name</th><th>Trigger</th><th>Status</th><th>Last Run</th></tr></thead>
        <tbody>
          {playbooks.map((p) => (
            <tr><td class="strong">{p.name}</td><td class="muted">{p.trigger}</td><td><Bits pill={p.status} /></td><td class="num">{p.lastRun}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>

  <FormDialog
    id="dlg-playbook" title="New playbook" submit="Create playbook" toast="Playbook created - review it before activating."
    fields={[{ name: 'describe', label: 'Describe it in plain language', type: 'textarea', placeholder: 'e.g. When a company with ICP above 80 visits pricing twice without booking, email the visitor a case for a 20-minute walkthrough the next morning.' }]}
  />
</AppShell>
