---
import AppShell from '../../layouts/AppShell.astro';
import AppHeader from '../../components/app/AppHeader.astro';
import Panel from '../../components/app/Panel.astro';
import Bits from '../../components/app/Bits.astro';
import { companies } from '../../data/app/sample';
const rows = [...companies].sort((a, b) => b.icp - a.icp);
---

<AppShell title="Companies" description="Account-level rollup of visitor sessions.">
  <AppHeader title="Companies" desc="Account-level rollup of all visitor sessions from the same company (B2B ABM view)." crumbs={[{ label: 'Visitors', href: '/app/visitors' }]} />

  <div class="filters">
    <label>Filter by ICP score
      <select data-filter-for="t-companies" data-filter-col="band">
        <option value="">All scores</option><option value="80">80 and above</option><option value="60">60–79</option><option value="0">Below 60</option>
      </select>
    </label>
  </div>

  <Panel empty="No companies identified yet." emptyIcon="building" flush>
    <div class="tbl-scroll">
      <table class="atbl" id="t-companies" data-filterable>
        <thead><tr><th>Company</th><th>Domain</th><th>Total Sessions</th><th>Highest ICP Score</th><th>Last Activity</th></tr></thead>
        <tbody>
          {rows.map((c) => (
            <tr data-band={c.icp >= 80 ? '80' : c.icp >= 60 ? '60' : '0'}>
              <td><a class="row-link" href={`/app/visitor/${c.visitorId}`}>{c.company}</a></td>
              <td class="muted">{c.domain}</td>
              <td class="num">{c.sessions}</td>
              <td><Bits score={c.icp} /></td>
              <td class="num">{c.last}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>
</AppShell>
