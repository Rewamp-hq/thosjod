---
// Spec: "Full lead record: conversation transcript, enrichment data, CRM sync status."
// Primary: Sync to CRM · Secondary: Book Meeting Manually · Success: "Synced to {CRM name}."
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import Panel from '../../../components/app/Panel.astro';
import Bits from '../../../components/app/Bits.astro';
import FormDialog from '../../../components/app/FormDialog.astro';
import Transcript from '../../../components/app/Transcript.astro';
import { leads, visitors, conversations, workspace, reps } from '../../../data/app/sample';

export function getStaticPaths() {
  return leads.map((l) => ({ params: { id: l.id }, props: { l } }));
}
const { l } = Astro.props as { l: (typeof leads)[number] };
const v = visitors.find((x) => x.id === l.visitorId);
const c = conversations.find((x) => x.id === l.conversationId);
---

<AppShell title={l.name} description="Lead detail">
  <AppHeader
    title={l.name}
    desc={`${l.company} · created ${l.created}`}
    crumbs={[{ label: 'Leads', href: '/app/leads' }]}
    actions={[
      { label: 'Book Meeting Manually', icon: 'cal', modal: 'dlg-book', variant: 'ghost' },
      { label: 'Sync to CRM', icon: 'sync', toast: `Synced to ${workspace.crm}.` },
    ]}
  />

  <div class="grid-main">
    <Panel title="Conversation transcript" sub={c ? `${c.agent} Agent · ${c.duration}` : undefined}>
      {c ? <Transcript messages={c.messages} /> : <p class="acard-sub">No conversation linked to this lead.</p>}
      {c && <p style="margin-top:14px"><a class="linkish" href={`/app/conversations/${c.id}`}>Open full conversation</a></p>}
    </Panel>

    <div style="display:grid;gap:16px">
      <Panel title="Qualification">
        <dl class="kv">
          <div><dt>ICP score</dt><dd><Bits score={l.icp} /></dd></div>
          <div><dt>Status</dt><dd><Bits pill={l.status} /></dd></div>
          <div><dt>Assigned rep</dt><dd>{l.rep ?? 'Unassigned'}</dd></div>
          <div><dt>Budget</dt><dd>{l.budget}</dd></div>
          <div><dt>Timeline</dt><dd>{l.timeline}</dd></div>
          <div><dt>Use case</dt><dd>{l.useCase}</dd></div>
        </dl>
      </Panel>
      <Panel title="CRM sync">
        <dl class="kv">
          <div><dt>{workspace.crm}</dt><dd><Bits pill={l.crmSynced ? 'Synced' : 'Not synced'} /></dd></div>
          <div><dt>Transcript attached</dt><dd>{l.crmSynced ? 'Yes' : 'On next sync'}</dd></div>
        </dl>
      </Panel>
      {v && (
        <Panel title="Enrichment">
          <dl class="kv">
            <div><dt>Title</dt><dd>{v.title ?? '-'}</dd></div>
            <div><dt>Industry</dt><dd>{v.industry ?? '-'}</dd></div>
            <div><dt>Company size</dt><dd>{v.size ?? '-'}</dd></div>
            <div><dt>Visitor profile</dt><dd><a class="linkish" href={`/app/visitor/${v.id}`}>Open</a></dd></div>
          </dl>
        </Panel>
      )}
    </div>
  </div>

  <FormDialog
    id="dlg-book" title="Book meeting manually" submit="Book meeting" toast="Meeting booked with {rep} on {date}."
    fields={[
      { name: 'rep', label: 'Rep', type: 'select', options: reps },
      { name: 'date', label: 'Date & time', type: 'datetime-local' },
    ]}
  />
</AppShell>
