---
import AppShell from '../../layouts/AppShell.astro';
import AppHeader from '../../components/app/AppHeader.astro';
import Panel from '../../components/app/Panel.astro';
import Bits from '../../components/app/Bits.astro';
import { outreach } from '../../data/app/sample';
---

<AppShell title="Outreach" description="Automated follow-up and social SDR activity log.">
  <AppHeader title="Outreach" desc="Automated follow-up and social SDR activity log." crumbs={[{ label: 'Agents', href: '/app/agents' }]} />

  <div class="filters">
    <label>Channel <select data-filter-for="t-out" data-filter-col="channel"><option value="">All</option><option>Email</option><option>Social</option></select></label>
    <label>Status <select data-filter-for="t-out" data-filter-col="status"><option value="">All</option><option value="replied">Replied</option><option value="opened">Opened, no reply</option><option value="sent">Sent</option></select></label>
  </div>

  <Panel empty="No outreach sent yet." emptyIcon="send" flush>
    <div class="tbl-scroll">
      <table class="atbl" id="t-out" data-filterable>
        <thead><tr><th>Recipient</th><th>Channel</th><th>Sent</th><th>Opened</th><th>Replied</th></tr></thead>
        <tbody>
          {outreach.map((o) => (
            <tr data-channel={o.channel} data-status={o.replied === 'Yes' ? 'replied' : o.opened === 'Yes' ? 'opened' : 'sent'}>
              <td class="strong">{o.recipient}</td><td><Bits pill={o.channel} /></td><td class="num">{o.sent}</td>
              <td class:list={{ muted: o.opened !== 'Yes' }}>{o.opened}</td><td>{o.replied === 'Yes' ? <Bits pill="Yes" /> : <span class="muted">No</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>
</AppShell>
