---
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import Panel from '../../../components/app/Panel.astro';
import { analyticsNav } from '../../../data/app/nav';
import { weekly, funnel } from '../../../data/app/sample';

const cards = [
  { title: 'Revenue', href: '/app/analytics/revenue', desc: 'Ties conversations and leads to downstream CRM stage and revenue.' },
  { title: 'Funnel', href: '/app/analytics/funnel', desc: 'Visitor progression through funnel stages, with drop-off flags.' },
  { title: 'Conversations', href: '/app/analytics/conversations', desc: 'Aggregate conversation quality metrics across all agents.' },
  { title: 'Sentiment', href: '/app/analytics/sentiment', desc: 'Aggregate sentiment scoring trends over time.' },
  { title: 'Heatmaps', href: '/app/analytics/heatmaps', desc: 'Click, scroll and attention aggregation per page.' },
];
const conv = weekly.conversations;
const qualifiedRate = ((funnel[3].value / funnel[0].value) * 100).toFixed(1);
---

<AppShell title="Analytics" description="Central reporting layer.">
  <AppHeader title="Analytics" desc="Central reporting layer." actions={[{ label: 'Export Report', icon: 'download', toast: 'Report export started - you’ll get an email when it’s ready.' }]} />
  <SubNav items={analyticsNav} />

  <section class="has-skel">
    <div class="skel metrics" aria-hidden="true"><div class="metric"><span></span></div><div class="metric"><span></span></div><div class="metric"><span></span></div><div class="metric"><span></span></div></div>
    <div class="metrics sample">
      <div class="metric"><span class="metric-k">Conversations (4 weeks)</span><span class="metric-v">{conv.reduce((a, b) => a + b, 0).toLocaleString('en-IN')}</span></div>
      <div class="metric"><span class="metric-k">Visitors → qualified</span><span class="metric-v">{qualifiedRate}%</span></div>
      <div class="metric"><span class="metric-k">Meetings (4 weeks)</span><span class="metric-v">{weekly.meetings.reduce((a, b) => a + b, 0)}</span></div>
      <div class="metric"><span class="metric-k">Leads (4 weeks)</span><span class="metric-v">{weekly.leads.reduce((a, b) => a + b, 0)}</span></div>
    </div>
    <div class="acard empty-app"><p>Not enough data yet - reports fill in as visitors start talking to your agents.</p></div>
  </section>

  <div class="grid-3">
    {cards.map((c) => (
      <a href={c.href} class="acard" style="display:grid;gap:6px">
        <span class="acard-title">{c.title}</span>
        <span class="acard-sub">{c.desc}</span>
      </a>
    ))}
  </div>
</AppShell>
