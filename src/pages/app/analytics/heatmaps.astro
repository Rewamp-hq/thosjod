---
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import Panel from '../../../components/app/Panel.astro';
import { analyticsNav } from '../../../data/app/nav';

const spots = [
  { x: 18, y: 18, s: 90, c: 'rgba(202,123,87,.75)' },   // hero CTA
  { x: 62, y: 20, s: 70, c: 'rgba(202,123,87,.5)' },
  { x: 30, y: 52, s: 120, c: 'rgba(89,74,255,.35)' },   // pricing table
  { x: 70, y: 58, s: 80, c: 'rgba(32,131,116,.45)' },
  { x: 85, y: 86, s: 60, c: 'rgba(202,123,87,.6)' },    // chat widget
];
---

<AppShell title="Heatmaps" description="Click/scroll/attention aggregation per page.">
  <AppHeader title="Heatmaps" desc="Click, scroll and attention aggregation per page." crumbs={[{ label: 'Analytics', href: '/app/analytics' }]} />
  <SubNav items={analyticsNav} />

  <div class="filters">
    <label>Page <select><option>/pricing</option><option>/</option><option>/platform</option></select></label>
    <label>Mode <select><option>Clicks</option><option>Scroll depth</option><option>Attention</option></select></label>
  </div>

  <Panel title="/pricing" sub="Clicks · last 30 days" empty="No heatmap data yet for this page." emptyIcon="eye">
    <div class="heatmap" role="img" aria-label="Click heatmap: hottest areas are the hero call to action, the pricing table and the chat widget">
      <div class="hm-page">
        <span class="hm-hero"></span><span></span><span style="width:60%"></span>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px"><span style="height:110px"></span><span style="height:110px"></span><span style="height:110px"></span><span style="height:110px"></span></div>
        <span></span><span style="width:80%"></span><span style="width:40%"></span>
      </div>
      {spots.map((s) => <span class="hm-spot" style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;background:${s.c};translate:-50% -50%`}></span>)}
    </div>
  </Panel>
</AppShell>
