---
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import Panel from '../../../components/app/Panel.astro';
import Bits from '../../../components/app/Bits.astro';
import { analyticsNav } from '../../../data/app/nav';
import { gaps } from '../../../data/app/sample';
---

<AppShell title="Conversation Analytics" description="Aggregate conversation quality metrics.">
  <AppHeader title="Conversations" desc="Aggregate conversation quality metrics across all agents." crumbs={[{ label: 'Analytics', href: '/app/analytics' }]} />
  <SubNav items={analyticsNav} />

  <section class="has-skel">
    <div class="skel metrics" aria-hidden="true"><div class="metric"><span></span></div><div class="metric"><span></span></div></div>
    <div class="metrics sample" style="grid-template-columns:repeat(2,minmax(0,1fr))">
      <div class="metric"><span class="metric-k">Avg. resolution rate <Bits tip="Share of conversations the agent resolved without a human." /></span><span class="metric-v">78%</span></div>
      <div class="metric"><span class="metric-k">Avg. handoff rate <Bits tip="Share of conversations handed to a human - usually because no grounded answer existed." /></span><span class="metric-v">14%</span></div>
    </div>
    <div class="acard empty-app"><p>No conversations yet.</p></div>
  </section>

  <Panel title="Top unanswered questions" empty="No unanswered questions yet." flush>
    <table class="atbl">
      <thead><tr><th>Question</th><th>Times asked</th><th></th></tr></thead>
      <tbody>{gaps.map((g) => <tr><td class="strong">{g.question}</td><td class="num">{g.frequency}</td><td style="text-align:right"><a class="linkish" href="/app/knowledge/gaps">Fix in Knowledge</a></td></tr>)}</tbody>
    </table>
  </Panel>
</AppShell>
