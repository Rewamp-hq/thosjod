---
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import Panel from '../../../components/app/Panel.astro';
import Action from '../../../components/app/Action.astro';
import FormDialog from '../../../components/app/FormDialog.astro';
import { visibilityNav } from '../../../data/app/nav';
import { prompts, visibility } from '../../../data/app/sample';
---

<AppShell title="Prompt Library" description="Manage tracked prompts.">
  <AppHeader title="Prompt Library" desc="Manage tracked prompts." crumbs={[{ label: 'AI Visibility', href: '/app/ai-visibility' }]} actions={[{ label: 'Add Prompt', icon: 'plus', modal: 'dlg-prompt' }]} />
  <SubNav items={visibilityNav} />

  <Panel empty="No prompts saved yet." emptyIcon="chat" emptyAction={{ label: 'Add Prompt', modal: 'dlg-prompt' }} flush>
    <div class="tbl-scroll">
      <table class="atbl" id="t-prompts" data-filterable>
        <thead><tr><th>Prompt</th><th>Engines tracked</th><th>Frequency</th><th></th></tr></thead>
        <tbody>
          {prompts.map((p) => (
            <tr>
              <td class="strong">{p}</td>
              <td>{visibility.filter((v) => v.prompt === p).map((v) => v.engine).join(', ') || '-'}</td>
              <td>Weekly</td>
              <td style="text-align:right">
                <Action label="Remove" variant="ghost" size="sm" removeRow confirm="Remove this prompt?" confirmBody={`“${p}” will stop being checked on every engine. Its past results stay in your reports.`} confirmOk="Remove prompt" toast="Prompt removed." />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>

  <FormDialog
    id="dlg-prompt" title="Add prompt" submit="Add prompt" toast="Prompt added - first check runs on the next schedule."
    fields={[
      { name: 'prompt', label: 'Prompt', placeholder: 'e.g. best AI tool to qualify website leads' },
      { name: 'freq', label: 'Frequency', type: 'select', options: ['Weekly', 'Daily (Scale)'] },
    ]}
  />
</AppShell>
