---
// Spec: "Side-by-side AI answer engine results." Primary: Run Audit Now
// Columns: Prompt, Engine, Brand Mentioned?, Competitor Mentioned?, Last Checked
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import Panel from '../../../components/app/Panel.astro';
import Bits from '../../../components/app/Bits.astro';
import { visibilityNav } from '../../../data/app/nav';
import { visibility, engines } from '../../../data/app/sample';

const mentioned = visibility.filter((v) => v.brand === 'Yes').length;
---

<AppShell title="AI Visibility" description="Side-by-side AI answer engine results.">
  <AppHeader title="AI Visibility" desc="Side-by-side AI answer engine results." actions={[{ label: 'Run Audit Now', icon: 'sync', href: '/app/ai-visibility/audit' }]} />
  <SubNav items={visibilityNav} />

  <section class="has-skel">
    <div class="skel metrics" aria-hidden="true"><div class="metric"><span></span></div><div class="metric"><span></span></div><div class="metric"><span></span></div></div>
    <div class="metrics sample" style="grid-template-columns:repeat(3,minmax(0,1fr))">
      <div class="metric"><span class="metric-k">Brand mentioned <Bits tip="Share of tracked prompt × engine checks where your brand appeared in the answer." /></span><span class="metric-v">{Math.round((mentioned / visibility.length) * 100)}%</span><span class="acard-sub">{mentioned} of {visibility.length} checks</span></div>
      <div class="metric"><span class="metric-k">Engines tracked <Bits tip={`Growth plan: weekly tracking on Gemini and ChatGPT. Scale: daily tracking across all ${engines.length} engines (${engines.join(', ')}).`} /></span><span class="metric-v">2 of {engines.length}</span><span class="acard-sub">Gemini, ChatGPT · <a class="linkish" href="/app/settings/billing">Upgrade for all {engines.length}</a></span></div>
      <div class="metric"><span class="metric-k">Live grounding <Bits tip="Gemini is queried with Google Search grounding enabled, so tracked answers reflect real, current output - not a simulation." /></span><span class="metric-v">Gemini</span><span class="acard-sub">Search-grounded</span></div>
    </div>
    <div class="acard empty-app"><p>No prompts tracked yet - add your first prompt.</p><a class="abtn abtn-sm" href="/app/ai-visibility/prompts">Add Prompt</a></div>
  </section>

  <div class="filters">
    <label>Engine <select data-filter-for="t-vis" data-filter-col="engine"><option value="">All</option>{[...new Set(visibility.map((v) => v.engine))].map((e) => <option>{e}</option>)}</select></label>
    <label>Brand mentioned <select data-filter-for="t-vis" data-filter-col="brand"><option value="">Any</option><option>Yes</option><option>No</option></select></label>
  </div>

  <Panel empty="No prompts tracked yet - add your first prompt." emptyIcon="eye" emptyAction={{ label: 'Add Prompt', href: '/app/ai-visibility/prompts' }} flush>
    <div class="tbl-scroll">
      <table class="atbl" id="t-vis" data-filterable>
        <thead><tr><th>Prompt</th><th>Engine</th><th>Brand Mentioned?</th><th>Competitor Mentioned?</th><th>Last Checked</th></tr></thead>
        <tbody>
          {visibility.map((v) => (
            <tr data-engine={v.engine} data-brand={v.brand}>
              <td class="strong">{v.prompt}</td><td>{v.engine}</td><td><Bits pill={v.brand} /></td>
              <td class:list={{ muted: v.competitor === '-' }}>{v.competitor}</td><td class="num">{v.checked}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>
</AppShell>
