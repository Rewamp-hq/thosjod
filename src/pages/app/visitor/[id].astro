---
// Spec: "Full enrichment profile and session history for one visitor."
// Primary: Route to Rep · Secondary: Add Note · Tooltip: enrichment confidence next to identified fields
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import Panel from '../../../components/app/Panel.astro';
import Bits from '../../../components/app/Bits.astro';
import FormDialog from '../../../components/app/FormDialog.astro';
import { visitors, reps, leads } from '../../../data/app/sample';

export function getStaticPaths() {
  return visitors.map((v) => ({ params: { id: v.id }, props: { v } }));
}
const { v } = Astro.props as { v: (typeof visitors)[number] };
const title = v.company ?? 'Anonymous visitor';
const conf = v.confidence ? `Enrichment confidence: ${v.confidence}%` : undefined;
const lead = leads.find((l) => l.visitorId === v.id);
const fields: [string, string | null][] = [
  ['Name', v.name], ['Email', v.email], ['Title', v.title], ['Company', v.company], ['Industry', v.industry], ['Company size', v.size],
];
---

<AppShell title={title} description="Visitor detail">
  <AppHeader
    title={title}
    desc={v.name ? `${v.name} · ${v.title}` : 'Identified by company, not yet by person.'}
    crumbs={[{ label: 'Visitors', href: '/app/visitors' }]}
    actions={[
      { label: 'Add Note', icon: 'note', modal: 'dlg-note', variant: 'ghost' },
      { label: 'Route to Rep', icon: 'route', modal: 'dlg-route' },
    ]}
  />

  <div class="grid-main">
    <div style="display:grid;gap:16px">
      <Panel title="Session history" sub={`${v.sessions.length} session${v.sessions.length > 1 ? 's' : ''} · ${v.pages} pages viewed`}>
        <table class="atbl">
          <thead><tr><th>When</th><th>Pages</th><th>Duration</th></tr></thead>
          <tbody>
            {v.sessions.map((s) => (
              <tr><td class="num">{s.when}</td><td>{s.pages.map((p) => <code style="font-size:12px;margin-right:6px">{p}</code>)}</td><td class="num">{s.duration}</td></tr>
            ))}
          </tbody>
        </table>
      </Panel>
      {lead && (
        <Panel title="Lead record">
          <p style="font-size:14px">Qualified as a lead on {lead.created} · <a class="linkish" href={`/app/leads/${lead.id}`}>Open lead</a></p>
        </Panel>
      )}
    </div>

    <Panel title="Enrichment profile">
      <dl class="kv">
        {fields.map(([k, val]) => (
          <div><dt>{k}{val && conf && <Bits tip={conf} />}</dt><dd class:list={{ muted: !val }}>{val ?? 'Not identified'}</dd></div>
        ))}
        <div><dt>ICP score</dt><dd><Bits score={v.icp} /></dd></div>
        <div><dt>Source</dt><dd>{v.source}</dd></div>
        <div><dt>Geography</dt><dd>{v.geo}</dd></div>
        <div><dt>Status</dt><dd><Bits pill={v.status} /></dd></div>
      </dl>
    </Panel>
  </div>

  <FormDialog id="dlg-route" title="Route to rep" submit="Route" toast="Lead routed to {rep}." fields={[{ name: 'rep', label: 'Rep', type: 'select', options: reps }]} />
  <FormDialog id="dlg-note" title="Add note" submit="Save note" toast="Note added." fields={[{ name: 'note', label: 'Note', type: 'textarea', placeholder: 'What should the team know about this visitor?' }]} />
</AppShell>
