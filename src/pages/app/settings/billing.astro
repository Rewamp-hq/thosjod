---
// Spec: Primary Upgrade Plan · Secondary View Invoices
// Metrics: credits used this cycle / included, current plan, next invoice date
// Plan & credit figures come from content/pages/pricing.md.
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import Panel from '../../../components/app/Panel.astro';
import Bits from '../../../components/app/Bits.astro';
import { settingsNav } from '../../../data/app/nav';
import { billing } from '../../../data/app/sample';

const pct = Math.round((billing.used / billing.included) * 100);
const usage = [
  { action: 'AI conversation turns', credits: 1, count: 6120 },
  { action: 'Visitors identified & enriched', credits: 2, count: 2400 },
  { action: 'AI-visibility prompt checks (per engine)', credits: 3, count: 320 },
  { action: 'Full GEO/AEO audit runs', credits: 50, count: 12 },
];
---

<AppShell title="Billing" description="Plan, credit usage, and invoices.">
  <AppHeader
    title="Billing"
    desc="Plan, credit usage, and invoices."
    crumbs={[{ label: 'Settings', href: '/app/settings' }]}
    actions={[
      { label: 'View Invoices', icon: 'page', toast: 'Invoices open in your billing portal once your workspace is live.', variant: 'ghost' },
      { label: 'Upgrade Plan', href: '/pricing' },
    ]}
  />
  <SubNav items={settingsNav} />

  <section class="has-skel">
    <div class="skel metrics" aria-hidden="true"><div class="metric"><span></span></div><div class="metric"><span></span></div><div class="metric"><span></span></div></div>
    <div class="metrics sample" style="grid-template-columns:repeat(3,minmax(0,1fr))">
      <div class="metric">
        <span class="metric-k">Credits used this cycle</span>
        <span class="metric-v">{billing.used.toLocaleString('en-IN')} <span class="acard-sub" style="font-size:14px">/ {billing.included.toLocaleString('en-IN')}</span></span>
        <span class="cr-bar"><span style={`width:${pct}%`}></span></span>
      </div>
      <div class="metric"><span class="metric-k">Current plan</span><span class="metric-v">{billing.plan}</span><span class="acard-sub">20,000 credits / month</span></div>
      <div class="metric"><span class="metric-k">Next invoice date</span><span class="metric-v">{billing.nextInvoice}</span></div>
    </div>
    <div class="acard empty-app"><p>No usage yet this cycle.</p></div>
  </section>

  <Panel title="Credit usage by action" sub="How credits work: each action has a fixed credit cost" flush>
    <div class="tbl-scroll">
      <table class="atbl">
        <thead><tr><th>Action</th><th>Credits each</th><th>Count</th><th>Credits used</th></tr></thead>
        <tbody>
          {usage.map((u) => <tr><td class="strong">{u.action}</td><td class="num">{u.credits}</td><td class="num">{u.count.toLocaleString('en-IN')}</td><td class="num">{(u.credits * u.count).toLocaleString('en-IN')}</td></tr>)}
        </tbody>
      </table>
    </div>
  </Panel>
  <p class="acard-sub">Overage is billed per credit at your plan’s rate, or you can upgrade tiers. <Bits tip="Upgrades apply immediately (pro-rated); downgrades take effect next billing cycle." /></p>
</AppShell>
