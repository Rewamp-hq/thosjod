---
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import Panel from '../../../components/app/Panel.astro';
import { settingsNav } from '../../../data/app/nav';
import { auditLog } from '../../../data/app/sample';

const users = [...new Set(auditLog.map((a) => a.user))];
const actions = [...new Set(auditLog.map((a) => a.action))];
---

<AppShell title="Audit Log" description="Full history of configuration changes.">
  <AppHeader title="Audit Log" desc="Full history of configuration changes, per the ‘full configuration & audit trail’ feature." crumbs={[{ label: 'Settings', href: '/app/settings' }]} />
  <SubNav items={settingsNav} />

  <div class="filters">
    <label>Date range <select data-filter-for="t-audit" data-filter-col="day"><option value="">Last 30 days</option><option value="2026-09-26">Today</option><option value="2026-09-25">Yesterday</option></select></label>
    <label>User <select data-filter-for="t-audit" data-filter-col="user"><option value="">All users</option>{users.map((u) => <option>{u}</option>)}</select></label>
    <label>Action type <select data-filter-for="t-audit" data-filter-col="action"><option value="">All actions</option>{actions.map((a) => <option>{a}</option>)}</select></label>
  </div>

  <Panel empty="No changes logged yet." emptyIcon="shield" flush>
    <div class="tbl-scroll">
      <table class="atbl" id="t-audit" data-filterable>
        <thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Details</th></tr></thead>
        <tbody>
          {auditLog.map((a) => (
            <tr data-day={a.ts.split(' ')[0]} data-user={a.user} data-action={a.action}>
              <td class="num">{a.ts}</td><td class="strong">{a.user}</td><td>{a.action}</td><td class="muted">{a.details}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>
</AppShell>
