---
// Spec: Primary Create Role · Empty "Using default roles (Admin, Editor, Viewer) - create a custom role if needed."
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import Panel from '../../../components/app/Panel.astro';
import FormDialog from '../../../components/app/FormDialog.astro';
import { settingsNav } from '../../../data/app/nav';

const perms = ['View leads & conversations', 'Edit agents & knowledge', 'Manage playbooks & routing', 'Manage integrations', 'Manage billing & team'];
const roles: [string, boolean[]][] = [
  ['Admin', [true, true, true, true, true]],
  ['Editor', [true, true, true, false, false]],
  ['Viewer', [true, false, false, false, false]],
];
---

<AppShell title="Permissions" description="Role-based access control configuration.">
  <AppHeader title="Permissions" desc="Role-based access control configuration." crumbs={[{ label: 'Settings', href: '/app/settings' }]} actions={[{ label: 'Create Role', icon: 'plus', modal: 'dlg-role' }]} />
  <SubNav items={settingsNav} />

  <p class="acard" style="font-size:14px">Using default roles (Admin, Editor, Viewer) - create a custom role if needed.</p>

  <Panel title="Default roles" flush>
    <div class="tbl-scroll">
      <table class="atbl">
        <thead><tr><th>Permission</th>{roles.map(([r]) => <th>{r}</th>)}</tr></thead>
        <tbody>
          {perms.map((p, i) => (
            <tr><td class="strong">{p}</td>{roles.map(([, allowed]) => <td>{allowed[i] ? <span class="pill green">Allowed</span> : <span class="muted">-</span>}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>

  <FormDialog
    id="dlg-role" title="Create role" submit="Create role" toast="Role “{name}” created."
    fields={[
      { name: 'name', label: 'Role name', placeholder: 'e.g. Regional sales lead' },
      { name: 'base', label: 'Start from', type: 'select', options: ['Viewer', 'Editor', 'Admin'] },
    ]}
  />
</AppShell>
