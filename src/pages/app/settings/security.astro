---
// Spec: "SSO configuration, session management, security log." Primary: Configure SSO (Scale/Enterprise only)
// Tooltip (lower tiers): "SSO is available on Scale and Enterprise plans - upgrade to enable."
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import Panel from '../../../components/app/Panel.astro';
import Bits from '../../../components/app/Bits.astro';
import Action from '../../../components/app/Action.astro';
import { settingsNav } from '../../../data/app/nav';
import { auditLog } from '../../../data/app/sample';

const sessions = [
  { who: 'Aisha Kapoor', device: 'Chrome · macOS', where: 'Mumbai, IN', last: 'Active now' },
  { who: 'Daniel Brooks', device: 'Edge · Windows', where: 'Singapore, SG', last: '2026-09-26 09:12' },
  { who: 'Mei Tanaka', device: 'Safari · iOS', where: 'Tokyo, JP', last: '2026-09-25 21:40' },
];
const SSO_TIP = 'SSO is available on Scale and Enterprise plans - upgrade to enable.';
---

<AppShell title="Security" description="SSO configuration, session management, security log.">
  <AppHeader title="Security" desc="SSO configuration, session management, security log." crumbs={[{ label: 'Settings', href: '/app/settings' }]}>
    <span class="tip" tabindex="0" data-tip={SSO_TIP} aria-label={SSO_TIP} style="display:inline-flex">
      <button class="abtn" disabled style="opacity:.5;cursor:not-allowed">Configure SSO</button>
    </span>
  </AppHeader>
  <SubNav items={settingsNav} />

  <Panel title="Single sign-on">
    <div class="toggle-row"><span>SAML / OIDC single sign-on<small>{SSO_TIP}</small></span><a class="abtn abtn-sm abtn-ghost" href="/pricing">See plans</a></div>
  </Panel>

  <Panel title="Active sessions" flush>
    <div class="tbl-scroll">
      <table class="atbl">
        <thead><tr><th>User</th><th>Device</th><th>Location</th><th>Last active</th><th></th></tr></thead>
        <tbody>
          {sessions.map((s, i) => (
            <tr>
              <td class="strong">{s.who}</td><td>{s.device}</td><td class="muted">{s.where}</td><td>{i === 0 ? <Bits pill="Active now" /> : <span class="num">{s.last}</span>}</td>
              <td style="text-align:right">{i > 0 && <Action label="Sign out" variant="ghost" size="sm" removeRow confirm={`Sign out ${s.who} on ${s.device}?`} confirmBody={`${s.who} will be signed out of this device immediately and must log in again. Their other sessions are not affected.`} confirmOk="Sign out" toast={`${s.who} signed out on ${s.device}.`} />}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>

  <Panel title="Security log" sub="Most recent configuration events - full history in Audit Log" flush>
    <table class="atbl"><tbody>{auditLog.slice(0, 3).map((a) => <tr><td class="num muted">{a.ts}</td><td class="strong">{a.action}</td><td class="muted">{a.user}</td></tr>)}</tbody></table>
  </Panel>
</AppShell>
