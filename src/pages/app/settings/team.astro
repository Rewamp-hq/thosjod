---
// Spec: Primary Invite Team Member · Columns Name, Email, Role, Status · Confirmation "Invite sent to {email}."
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import Panel from '../../../components/app/Panel.astro';
import Bits from '../../../components/app/Bits.astro';
import Action from '../../../components/app/Action.astro';
import FormDialog from '../../../components/app/FormDialog.astro';
import { settingsNav } from '../../../data/app/nav';
import { team } from '../../../data/app/sample';
---

<AppShell title="Team" description="Manage team members and invites.">
  <AppHeader title="Team" desc="Manage team members and invites." crumbs={[{ label: 'Settings', href: '/app/settings' }]} actions={[{ label: 'Invite Team Member', icon: 'plus', modal: 'dlg-invite' }]} />
  <SubNav items={settingsNav} />

  <Panel empty="It’s just you so far - invite your team." emptyIcon="user" emptyAction={{ label: 'Invite Team Member', modal: 'dlg-invite' }} flush>
    <div class="tbl-scroll">
      <table class="atbl" id="t-team" data-filterable>
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead>
        <tbody>
          {team.map((m, i) => (
            <tr>
              <td class="strong">{m.name}</td><td class="muted">{m.email}</td><td>{m.role}</td><td><Bits pill={m.status} /></td>
              <td style="text-align:right">{i > 0 && (
                <Action label="Remove" variant="ghost" size="sm" removeRow confirm={`Remove ${m.name}?`} confirmBody={`${m.name} (${m.email}) will lose access to the ${m.role === 'Viewer' ? 'workspace' : 'workspace and every agent, playbook and integration they can edit'} immediately. Leads assigned to them stay assigned until you reroute them.`} confirmOk="Remove member" toast={`${m.name} removed.`} />
              )}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>

  <FormDialog
    id="dlg-invite" title="Invite team member" submit="Send invite" toast="Invite sent to {email}."
    fields={[
      { name: 'email', label: 'Work email', type: 'email', placeholder: 'name@company.com' },
      { name: 'role', label: 'Role', type: 'select', options: ['Admin', 'Editor', 'Viewer'] },
    ]}
  />
</AppShell>
