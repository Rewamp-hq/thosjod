---
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import SubNav from '../../../components/app/SubNav.astro';
import { settingsNav } from '../../../data/app/nav';

const cards = [
  { t: 'Team', d: 'Manage team members and invites.', h: '/app/settings/team' },
  { t: 'Permissions', d: 'Role-based access control configuration.', h: '/app/settings/permissions' },
  { t: 'Billing', d: 'Plan, credit usage, and invoices.', h: '/app/settings/billing' },
  { t: 'Security', d: 'SSO configuration, session management, security log.', h: '/app/settings/security' },
  { t: 'Notifications', d: 'Alert preferences - new lead, meeting booked, audit complete.', h: '/app/settings/notifications' },
  { t: 'API', d: 'API key management (Scale/Enterprise).', h: '/app/settings/api' },
  { t: 'Audit Log', d: 'Full history of configuration changes.', h: '/app/settings/audit-log' },
];
---

<AppShell title="Settings" description="Account-level settings hub.">
  <AppHeader title="Settings" desc="Account-level settings hub." />
  <SubNav items={settingsNav} />
  <div class="grid-3">
    {cards.map((c) => <a class="acard" href={c.h} style="display:grid;gap:6px"><span class="acard-title">{c.t}</span><span class="acard-sub">{c.d}</span></a>)}
  </div>
</AppShell>
