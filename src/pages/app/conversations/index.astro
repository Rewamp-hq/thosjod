---
import AppShell from '../../../layouts/AppShell.astro';
import AppHeader from '../../../components/app/AppHeader.astro';
import Panel from '../../../components/app/Panel.astro';
import Bits from '../../../components/app/Bits.astro';
import { conversations } from '../../../data/app/sample';
const band = (s: number) => (s >= 0.6 ? 'Positive' : s >= 0.4 ? 'Neutral' : 'Negative');
---

<AppShell title="Conversations" description="All AI agent conversations, sales and support.">
  <AppHeader title="Conversations" desc="All AI agent conversations, sales and support." />

  <div class="filters">
    <label>Agent type <select data-filter-for="t-conv" data-filter-col="agent"><option value="">All</option><option>Sales</option><option>Support</option><option>Voice</option></select></label>
    <label>Sentiment <select data-filter-for="t-conv" data-filter-col="sent"><option value="">All</option><option>Positive</option><option>Neutral</option><option>Negative</option></select></label>
    <label>Date <select data-filter-for="t-conv" data-filter-col="week"><option value="">Last 14 days</option><option value="this">This week</option></select></label>
  </div>

  <Panel empty="No conversations yet." emptyIcon="chat" flush>
    <div class="tbl-scroll">
      <table class="atbl" id="t-conv" data-filterable>
        <thead><tr><th>Visitor</th><th>Agent</th><th>Sentiment Score <Bits tip="0 = very negative, 1 = very positive, averaged across the visitor’s messages." /></th><th>Duration</th><th>Outcome</th></tr></thead>
        <tbody>
          {conversations.map((c) => (
            <tr data-agent={c.agent} data-sent={band(c.sentiment)} data-week={c.date >= '2026-09-21' ? 'this' : ''}>
              <td><a class="row-link" href={`/app/conversations/${c.id}`}>{c.visitor}</a><br /><span class="muted">{c.date}</span></td>
              <td><Bits pill={c.agent} /></td>
              <td class="num">{c.sentiment.toFixed(2)} <span class="muted">· {band(c.sentiment)}</span></td>
              <td class="num">{c.duration}</td>
              <td><Bits pill={c.outcome} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>
</AppShell>
