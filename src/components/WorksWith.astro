---
import { worksWith } from '../data/home';
const row = [...worksWith, ...worksWith];
---

<div class="ww container" aria-label="Works with">
  <p class="ww-label">Works with</p>
  <div class="ww-track-wrap">
    <ul class="ww-track">
      {row.map((name, i) => (
        <li aria-hidden={i >= worksWith.length ? 'true' : undefined}>{name}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .ww { height: 120px; display: flex; align-items: center; gap: 40px; }
  .ww-label { flex-shrink: 0; font-size: 14px; font-weight: 500; color: var(--muted-3); }
  .ww-track-wrap {
    flex: 1; overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .ww-track { display: flex; gap: 64px; width: max-content; animation: ww 40s linear infinite; }
  .ww-track li {
    font-family: var(--font-head);
    font-size: 22px;
    letter-spacing: 0.01em;
    color: rgba(26, 24, 20, 0.42);
    white-space: nowrap;
  }
  .ww:hover .ww-track { animation-play-state: paused; }
  @keyframes ww { to { transform: translateX(calc(-50% - 32px)); } }
  @media (max-width: 809px) {
    .ww { height: 96px; gap: 20px; }
    .ww-track li { font-size: 18px; }
  }
</style>
