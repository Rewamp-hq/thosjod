---
import { mainNav, site } from '../data/site';
import Logo from './Logo.astro';
---

<header class="hdr" data-hdr>
  <div class="hdr-inner container">
    <div class="hdr-bg" aria-hidden="true"></div>

    <a href="/" class="hdr-logo" aria-label="Thosjod home">
      <Logo />
    </a>

    <nav class="hdr-nav" aria-label="Main">
      <ul class="hdr-list">
        {mainNav.map((item) => (
          <li class={item.columns ? 'has-menu' : ''}>
            {item.columns ? (
              <>
                <button class="hdr-link" aria-expanded="false" aria-haspopup="true">
                  {item.label}
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <div class="menu" role="menu">
                  <div class={`menu-grid cols-${item.columns.length}`}>
                    {item.columns.map((col) => (
                      <div class="menu-col">
                        <p class="menu-title">{col.title}</p>
                        <ul class={col.links.length > 8 ? 'menu-links two' : 'menu-links'}>
                          {col.links.map((l) => (
                            <li>
                              <a href={l.href} class="menu-link" role="menuitem">
                                {l.badge && <span class={`badge badge-${l.tone ?? 'ink'}`}>{l.badge}</span>}
                                <span>
                                  <span class="menu-label">{l.label}</span>
                                  {l.desc && <span class="menu-desc">{l.desc}</span>}
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <a class="hdr-link" href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr-actions">
      <a href={site.signInHref} class="btn hdr-signin">Sign in</a>
      <a href={site.demoHref} class="btn hdr-cta">Book a Demo</a>
      <button class="hdr-burger" aria-label="Open menu" aria-expanded="false" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="mnav" data-mnav hidden>
    <div class="mnav-body container">
      {mainNav.map((item) =>
        item.columns ? (
          <details class="mnav-group">
            <summary>
              {item.label}
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </summary>
            {item.columns.map((col) => (
              <div class="mnav-col">
                <p class="menu-title">{col.title}</p>
                {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
              </div>
            ))}
          </details>
        ) : (
          <a class="mnav-top" href={item.href}>{item.label}</a>
        ),
      )}
      <div class="mnav-actions">
        <a href={site.signInHref} class="btn btn-ghost">Sign in</a>
        <a href={site.demoHref} class="btn btn-dark">Book a Demo</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    color: #fff;
    --logo-dark: 0;
  }
  .hdr-inner {
    position: relative;
    height: 88px;
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .hdr-bg {
    position: absolute;
    inset: 8px var(--gutter);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0);
    transition: background-color 0.35s var(--ease), box-shadow 0.35s var(--ease), backdrop-filter 0.35s;
    pointer-events: none;
  }
  .hdr-logo { position: relative; display: flex; align-items: center; margin-left: 8px; }
  .hdr-nav { position: relative; margin-left: auto; }
  .hdr-list { display: flex; align-items: center; gap: 2px; }
  .hdr-list > li { position: relative; }
  .hdr-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 40px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: background-color 0.2s, opacity 0.2s;
  }
  .hdr-link:hover { background: rgba(255, 255, 255, 0.14); }
  .hdr-link svg { width: 14px; height: 14px; opacity: 0.8; transition: transform 0.25s var(--ease); }
  .has-menu:hover .hdr-link svg,
  .has-menu:focus-within .hdr-link svg { transform: rotate(180deg); }

  .hdr-actions { position: relative; display: flex; align-items: center; gap: 8px; margin-right: 8px; }
  .hdr-signin { background: rgba(255, 255, 255, 0.24); color: #fff; backdrop-filter: blur(11.6px); -webkit-backdrop-filter: blur(11.6px); }
  .hdr-signin:hover { background: rgba(255, 255, 255, 0.34); }
  .hdr-cta { background: #fff; color: var(--ink); }
  .hdr-cta:hover { background: #f0efee; }

  /* Mega menu */
  .menu {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    translate: -50% 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s;
    color: var(--ink);
  }
  .menu::before { content: ''; position: absolute; inset: -16px 0 auto 0; height: 16px; }
  .has-menu:hover .menu,
  .has-menu:focus-within .menu { opacity: 1; visibility: visible; transform: none; }
  .menu-grid {
    display: grid;
    gap: 8px;
    padding: 8px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 0 0 1px rgba(26, 24, 20, 0.06), 0 24px 48px -12px rgba(26, 24, 20, 0.18);
  }
  .menu-grid.cols-2 { grid-template-columns: auto auto; }
  .menu-col { padding: 12px; border-radius: 12px; min-width: 260px; }
  .menu-col + .menu-col { background: var(--bg); }
  .menu-title { font-size: 12px; font-weight: 500; color: var(--muted-3); text-transform: uppercase; letter-spacing: 0.04em; padding: 0 8px 8px; }
  .menu-links { display: grid; gap: 2px; }
  .menu-links.two { grid-template-columns: 1fr 1fr; column-gap: 8px; }
  .menu-link {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 20px;
    transition: background-color 0.2s;
    white-space: nowrap;
  }
  .menu-link:hover { background: rgba(26, 24, 20, 0.05); }
  .menu-link .badge { margin-top: 0; }
  .menu-label { display: block; font-weight: 500; }
  .menu-desc { display: block; color: var(--muted); font-size: 13px; }

  /* Scrolled / light state */
  .hdr.is-light { color: var(--ink); --logo-dark: 1; }
  .hdr.is-light .hdr-bg {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: 0 0 0 1px rgba(26, 24, 20, 0.04), 0 8px 24px -12px rgba(26, 24, 20, 0.12);
  }
  .hdr.is-light .hdr-link:hover { background: rgba(26, 24, 20, 0.05); }
  .hdr.is-light .hdr-signin { background: #fff; color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); backdrop-filter: none; }
  .hdr.is-light .hdr-signin:hover { background: var(--line-soft); }
  .hdr.is-light .hdr-cta { background: var(--ink); color: #fff; }
  .hdr.is-light .hdr-cta:hover { background: var(--ink-3); }

  /* Burger + mobile */
  .hdr-burger { display: none; width: 40px; height: 40px; border-radius: 999px; position: relative; }
  .hdr-burger span {
    position: absolute; left: 12px; right: 12px; height: 1.5px; background: currentColor; border-radius: 2px;
    transition: transform 0.3s var(--ease), top 0.3s var(--ease);
  }
  .hdr-burger span:first-child { top: 16px; }
  .hdr-burger span:last-child { top: 23px; }
  .hdr.menu-open .hdr-burger span:first-child { top: 19.5px; transform: rotate(45deg); }
  .hdr.menu-open .hdr-burger span:last-child { top: 19.5px; transform: rotate(-45deg); }

  .mnav {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: #fff;
    color: var(--ink);
    overflow-y: auto;
    padding-top: 88px;
  }
  .mnav-body { display: flex; flex-direction: column; padding-bottom: 32px; }
  .mnav-top, .mnav-group > summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 4px; font-family: var(--font-head); font-size: 22px; line-height: 28px;
    border-bottom: 1px solid var(--line-soft); cursor: pointer; list-style: none;
  }
  .mnav-group > summary::-webkit-details-marker { display: none; }
  .mnav-group > summary svg { width: 18px; height: 18px; transition: transform 0.25s; }
  .mnav-group[open] > summary svg { transform: rotate(180deg); }
  .mnav-col { padding: 16px 4px 8px; display: grid; gap: 2px; }
  .mnav-col .menu-title { padding: 0 0 6px; }
  .mnav-col a { padding: 8px 0; font-size: 16px; color: var(--muted); }
  .mnav-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 24px; }

  @media (max-width: 1099px) {
    .hdr-nav, .hdr-signin, .hdr-cta { display: none; }
    .hdr-burger { display: block; }
    .hdr-actions { margin-left: auto; }
    .hdr.menu-open { color: var(--ink); --logo-dark: 1; }
    .hdr.menu-open .hdr-bg { background: transparent; box-shadow: none; }
  }
  @media (max-width: 809px) {
    .hdr-inner { height: 72px; padding-top: 16px; padding-bottom: 16px; }
    .hdr-bg { inset: 6px var(--gutter); }
    .mnav { padding-top: 72px; }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr]')!;
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;
  const mnav = document.querySelector<HTMLElement>('[data-mnav]')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  // Light "pill" header once the content sheet slides under the header
  const update = () => {
    // Pages without a dark hero get the solid pill header from the start
    hdr.classList.toggle('is-light', !hero || window.scrollY > hero.offsetHeight - 80);
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);

  burger.addEventListener('click', () => {
    const open = !hdr.classList.contains('menu-open');
    hdr.classList.toggle('menu-open', open);
    mnav.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
  });

  // Keyboard: keep aria-expanded in sync for dropdown buttons
  document.querySelectorAll<HTMLLIElement>('.has-menu').forEach((li) => {
    const btn = li.querySelector('button')!;
    li.addEventListener('mouseenter', () => btn.setAttribute('aria-expanded', 'true'));
    li.addEventListener('mouseleave', () => btn.setAttribute('aria-expanded', 'false'));
    li.addEventListener('focusin', () => btn.setAttribute('aria-expanded', 'true'));
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node)) btn.setAttribute('aria-expanded', 'false');
    });
  });
</script>
