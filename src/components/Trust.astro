---
import { trust } from '../data/home';
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';
---

<section class="trust" aria-labelledby="trust-title">
  <div class="container trust-grid">
    <div class="trust-left">
      <div class="section-title reveal">
        <Eyebrow>{trust.eyebrow}</Eyebrow>
        <h2 id="trust-title" class="h2">{trust.title}</h2>
        <p class="body-sm trust-sub">{trust.sub}</p>
      </div>

      <ol class="trust-list">
        {trust.items.map((it, i) => (
          <li class="reveal" data-delay={i}>
            <p class="trust-item-title">{it.title}</p>
            <p class="body-sm">{it.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="trust-play reveal" aria-hidden="true">
      <div class="q-card">
        <Icon name="chat" size={14} />
        <span>“Is SSO included on the Scale plan?”</span>
      </div>

      <div class="stack">
        {trust.layers.map((l, i) => (
          <div class="layer" style={`--i:${i}`}></div>
        ))}
        {trust.layers.map((l, i) => (
          <span class="layer-label" style={`--i:${i}`}><b>0{i + 1}</b>{l}</span>
        ))}
        <span class="packet"></span>
      </div>

      <div class="a-card">
        <span class="a-check"><Icon name="shield" size={14} /></span>
        <div>
          <p class="a-title">Answer verified</p>
          <p class="a-meta">Source: Enterprise · Security & Governance</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust { background: #fff; padding: 88px 0; }
  .trust-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px 56px; }
  .trust-left { display: flex; flex-direction: column; justify-content: space-between; gap: 48px; }
  .trust-sub { max-width: 420px; }
  .trust-list { display: flex; flex-direction: column; gap: 32px; padding: 0; margin: 0; list-style: none; max-width: 480px; }
  .trust-list li { display: flex; flex-direction: column; gap: 6px; }
  .trust-item-title { font-size: 16px; font-weight: 500; line-height: 24px; letter-spacing: -0.01em; }

  .trust-play {
    position: relative;
    min-height: 652px;
    border-radius: 16px;
    background: var(--bg);
    overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: space-between;
    padding: 40px 24px;
  }
  .q-card, .a-card {
    position: relative; z-index: 2;
    display: flex; align-items: center; gap: 10px;
    padding: 12px 16px;
    background: #fff; border-radius: 12px;
    font-size: 14px;
    box-shadow: 0 0 0 1px rgba(26, 24, 20, 0.06), 0 12px 24px -16px rgba(26, 24, 20, 0.25);
  }
  .q-card { color: var(--ink); }
  .a-check { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; color: var(--teal); background: color-mix(in srgb, var(--teal) 12%, #fff); }
  .a-title { font-weight: 500; }
  .a-meta { font-size: 12px; color: var(--muted); }
  .a-card { animation: aIn 4.5s var(--ease) infinite; }
  @keyframes aIn { 0%, 55% { opacity: 0.35; transform: translateY(6px); } 70%, 100% { opacity: 1; transform: none; } }

  .stack { position: relative; width: 320px; height: 360px; perspective: 1200px; }
  .layer {
    position: absolute; left: 50%; top: 50%;
    width: 240px; height: 240px;
    margin: -120px 0 0 -120px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(26, 24, 20, 0.1);
    box-shadow: 0 30px 60px -30px rgba(26, 24, 20, 0.35);
    transform: rotateX(58deg) rotateZ(-40deg) translateZ(calc((1 - var(--i)) * 90px));
    transform-style: preserve-3d;
    animation: layerGlow 4.5s var(--ease) infinite;
    animation-delay: calc(var(--i) * 0.6s + 0.4s);
  }
  .layer:nth-child(1) { background: rgba(32, 131, 116, 0.1); border-color: rgba(32, 131, 116, 0.35); }
  .layer:nth-child(2) { background: rgba(202, 123, 87, 0.1); border-color: rgba(202, 123, 87, 0.35); }
  .layer:nth-child(3) { background: rgba(89, 74, 255, 0.08); border-color: rgba(89, 74, 255, 0.3); }
  @keyframes layerGlow { 0%, 100% { filter: none; } 12% { filter: brightness(0.92) saturate(1.6); } }
  .layer-label {
    position: absolute; right: -64px; top: calc(28% + var(--i) * 90px);
    display: flex; gap: 6px; white-space: nowrap;
    font-size: 13px; font-weight: 500; color: var(--ink);
    background: #fff; padding: 4px 10px; border-radius: 999px;
    box-shadow: 0 0 0 1px rgba(26, 24, 20, 0.06), 0 6px 16px -10px rgba(26, 24, 20, 0.3);
    z-index: 4;
  }
  .layer-label b { font-weight: 500; color: var(--muted-3); }
  .packet {
    position: absolute; left: 50%; top: 0; width: 10px; height: 10px; margin-left: -5px;
    border-radius: 50%; background: var(--ink);
    box-shadow: 0 0 0 6px rgba(26, 24, 20, 0.08);
    animation: drop 4.5s var(--ease) infinite;
    z-index: 3;
  }
  @keyframes drop { 0% { top: -8%; opacity: 0; } 8% { opacity: 1; } 62% { top: 100%; opacity: 1; } 70%, 100% { top: 104%; opacity: 0; } }

  @media (max-width: 1099px) {
    .trust-grid { grid-template-columns: 1fr; }
    .trust-play { min-height: 560px; }
  }
  @media (max-width: 809px) {
    .trust { padding: 80px 0; }
    .trust-play { min-height: 500px; padding: 28px 16px; }
    .stack { transform: scale(0.82); }
    .layer-label { display: none; }
  }
</style>
