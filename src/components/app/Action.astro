---
// A button/link wired to the AppShell behaviours: toast, modal, confirm dialog, or navigation.
import Icon from '../Icon.astro';
export type ActionSpec = {
  label: string;
  href?: string;
  toast?: string;
  modal?: string;
  confirm?: string;
  confirmBody?: string;
  confirmOk?: string;
  icon?: string;
  variant?: 'primary' | 'ghost' | 'danger';
  size?: 'sm';
  removeRow?: boolean;
};
interface Props extends ActionSpec {}
const { label, href, toast, modal, confirm, confirmBody, confirmOk, icon, variant = 'primary', size, removeRow } = Astro.props;
const cls = ['abtn', variant === 'ghost' && 'abtn-ghost', variant === 'danger' && 'abtn-danger', size === 'sm' && 'abtn-sm'].filter(Boolean).join(' ');
const data = {
  'data-toast': toast,
  'data-open-modal': modal,
  'data-confirm': confirm,
  'data-confirm-body': confirmBody,
  'data-confirm-ok': confirmOk,
  'data-remove-row': removeRow ? '' : undefined,
};
---

{href && !toast && !modal && !confirm ? (
  <a class={cls} href={href}>{icon && <Icon name={icon} size={15} />}{label}</a>
) : (
  <button type="button" class={cls} {...data}>{icon && <Icon name={icon} size={15} />}{label}</button>
)}
