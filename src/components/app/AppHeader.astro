---
// Page title block for /app/* screens. Put action buttons in the default slot.
import Icon from '../Icon.astro';

interface Props {
  title: string;
  desc?: string;
  crumbs?: { label: string; href: string }[];
}
const { title, desc, crumbs = [] } = Astro.props;
---

<div class="ahead">
  <div>
    {crumbs.length > 0 && (
      <nav class="ahead-crumb" aria-label="Breadcrumb">
        {crumbs.map((c) => (<><a href={c.href}>{c.label}</a><Icon name="arrow-right" size={12} /></>))}
        <span aria-current="page" data-crumb-current>{title}</span>
      </nav>
    )}
    <h1 data-page-title>{title}</h1>
    {desc && <p class="ahead-desc">{desc}</p>}
  </div>
  {Astro.slots.has('default') && <div class="ahead-actions"><slot /></div>}
</div>
