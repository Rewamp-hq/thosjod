---
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';
import { md } from '../lib/inline';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'Questions, answered.' } = Astro.props;
---

<section class="faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="section-title reveal">
      <Eyebrow>FAQ</Eyebrow>
      <h2 id="faq-title" class="h2">{title}</h2>
      <p class="body-sm">Still curious? <a href="/contact" class="faq-link">Talk to our team</a>.</p>
    </div>

    <div class="faq-list">
      {items.map((it, i) => (
        <details class="faq-item reveal" data-delay={i} open={i === 0}>
          <summary>
            <span set:html={md(it.q)} />
            <span class="faq-icon"><Icon name="plus" size={16} /></span>
          </summary>
          <div class="faq-a"><p set:html={md(it.a)} /></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: #fff; padding: 64px 0 120px; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: 56px; align-items: start; }
  .faq-link { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item { background: var(--bg); border-radius: 16px; transition: background-color 0.25s; }
  .faq-item[open] { background: #f0efee; }
  .faq-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 20px 24px;
    font-size: 16px; font-weight: 500; line-height: 24px; letter-spacing: -0.01em;
    cursor: pointer; list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-icon { width: 28px; height: 28px; flex-shrink: 0; display: grid; place-items: center; border-radius: 999px; background: #fff; transition: transform 0.3s var(--ease); }
  .faq-item[open] .faq-icon { transform: rotate(45deg); }
  .faq-a :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .faq-a { padding: 0 24px 22px; font-size: 15px; line-height: 22px; color: var(--muted); max-width: 620px; }
  @media (max-width: 1099px) { .faq-grid { grid-template-columns: 1fr; gap: 32px; } }
  @media (max-width: 809px) {
    .faq { padding: 40px 0 80px; }
    .faq-item summary { padding: 16px 18px; font-size: 15px; }
    .faq-a { padding: 0 18px 18px; }
  }
</style>
