# Copy to .env and fill in. Every value is optional - features switch on only when set.

# ---- Forms (demo, contact, newsletter, audit tools) ----
# Any endpoint that accepts a POST of form data (Formspree, HubSpot Forms, your own API...)
PUBLIC_FORM_ENDPOINT=

# ---- Search engine verification (meta tags) ----
# Google Search Console: the "content" value of the HTML-tag verification method
PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools: the "content" value of the msvalidate.01 meta tag
PUBLIC_BING_VERIFICATION=

# ---- Analytics (each loads only after the visitor accepts cookies) ----
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA4_ID=
# Microsoft Clarity project ID (heatmaps + session recordings)
PUBLIC_CLARITY_ID=
# LinkedIn Insight Tag partner ID (B2B campaign measurement)
PUBLIC_LINKEDIN_PARTNER_ID=

# ---- Structured data ----
# Comma-separated official profile URLs, added as Organization.sameAs in JSON-LD
# e.g. https://www.linkedin.com/company/thosjod,https://x.com/thosjod
PUBLIC_SOCIAL_LINKS=
